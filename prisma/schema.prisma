generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Room {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  name          String        @unique
  consoleType   String        // e.g. "PS4", "PS5"
  hourlyRate    Float
  discountRate  Float?        
  discountStart Int?         
  discountEnd   Int?          
  reservations  Reservation[]
  createdAt     DateTime      @default(now())
}

model Reservation {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  roomId           String   @db.ObjectId
  room             Room     @relation(fields: [roomId], references: [id])
  customerName     String?
  customerPhone    String?
  transferToNumber String?
  transferImage    String?
  isOpentime       Boolean  @default(false)
  startTime        DateTime
  endTime          DateTime?
  totalPrice       Float?
  status           String   @default("pending") // pending, active, completed, cancelled
  createdAt        DateTime @default(now())
}

model Settings {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  playstationName    String   @default("PLAYSTATION NAME")
  logoImage          String?
  instapayNumber     String?
  vodafoneCashNumber String?
  updatedAt          DateTime @updatedAt
}

model Employee {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  username  String       @unique
  password  String
  role      String       @default("employee")
  phone     String?
  shift     String?
  salary    Float?
  isActive  Boolean      @default(true)
  attendance Attendance[]
  breakRequests BreakRequest[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Announcement {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  content     String
  targetRole  String?
  createdAt   DateTime @default(now())
}

model Attendance {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId  String   @db.ObjectId
  employee    Employee @relation(fields: [employeeId], references: [id])
  clockIn     DateTime @default(now())
  clockOut    DateTime?
  date        String
}

model BreakRequest {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId  String   @db.ObjectId
  employee    Employee @relation(fields: [employeeId], references: [id])
  type        String   // "break" or "permission"
  reason      String
  duration    String?  // e.g. "15 min", "30 min", "1 hour"
  status      String   @default("pending") // pending, approved, rejected
  adminNote   String?
  createdAt   DateTime @default(now())
}
