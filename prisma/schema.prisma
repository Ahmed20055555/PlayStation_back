generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Room {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  name          String        @unique
  consoleType   String        // e.g. "PS4", "PS5"
  hourlyRate    Float
  discountRate  Float?        
  discountStart Int?         
  discountEnd   Int?          
  reservations  Reservation[]
  createdAt     DateTime      @default(now())
}

model Reservation {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  roomId           String   @db.ObjectId
  room             Room     @relation(fields: [roomId], references: [id])
  customerName     String?
  customerPhone    String?
  transferToNumber String?
  transferImage    String?
  isOpentime       Boolean  @default(false)
  startTime        DateTime
  endTime          DateTime?
  totalPrice       Float?
  status           String   @default("pending") // pending, active, completed, cancelled
  createdAt        DateTime @default(now())
}

model Settings {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  playstationName    String   @default("PLAYSTATION NAME")
  logoImage          String?
  instapayNumber     String?
  vodafoneCashNumber String?
  updatedAt          DateTime @updatedAt
}
